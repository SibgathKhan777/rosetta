# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=video_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/video_platform

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=video-platform-temp
S3_REGION=us-east-1

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Vision LLM escalation (stage 6) ---
# Any OpenAI-compatible vision endpoint. Leave blank to disable escalation.
VISION_LLM_API_KEY=
VISION_LLM_MODEL=gpt-4o-mini
VISION_LLM_MAX_FRAMES_PER_JOB=20
