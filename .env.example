# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=video_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/video_platform

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=video-platform-temp
S3_REGION=us-east-1

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# JSON array of allowed browser origins for the frontend to call the API from.
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Vision LLM escalation (stage 6) ---
# Any OpenAI-compatible vision endpoint. Leave blank to disable escalation.
# Confirmed working against Groq (https://api.groq.com/openai/v1) with
# qwen/qwen3.6-27b — the only vision-capable model on a fresh Groq project may
# need it explicitly enabled at both the org AND project level under
# console.groq.com/settings/limits before the API key can use it.
VISION_LLM_API_KEY=
VISION_LLM_BASE_URL=https://api.openai.com/v1
VISION_LLM_MODEL=gpt-4o-mini
VISION_LLM_MAX_FRAMES_PER_JOB=20

# --- Password reset email (stage 17) ---
# Get a free API key at resend.com. Without a verified domain, Resend's
# sandbox sender (onboarding@resend.dev) can only deliver to the email
# address that owns the Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Rosetta <onboarding@resend.dev>
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
