# Production environment template. Copy to `.env.production` on the server
# and fill in real values — never commit `.env.production` itself.
#
# Generate strong secrets directly on the server (don't reuse examples from
# a chat/doc — anything pasted into a conversation should be treated as
# already-exposed):
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Postgres ---
POSTGRES_USER=video_platform
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=video_platform
DATABASE_URL=postgresql+psycopg2://video_platform:REPLACE_ME@postgres:5432/video_platform

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible object storage) ---
# S3_ACCESS_KEY/S3_SECRET_KEY must match MINIO_ROOT_USER/MINIO_ROOT_PASSWORD
# below — same instance, two names because one config block is consumed by
# the minio container and the other by the app's boto3 client.
MINIO_ROOT_USER=REPLACE_ME
MINIO_ROOT_PASSWORD=REPLACE_ME
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_BUCKET=video-platform-prod
S3_REGION=us-east-1

# --- Auth ---
JWT_SECRET_KEY=REPLACE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- App ---
ENVIRONMENT=production
LOG_LEVEL=INFO
# Your actual Vercel frontend domain(s) — no localhost in production.
CORS_ALLOWED_ORIGINS=["https://your-app.vercel.app"]

# --- Vision LLM escalation + explanation (stages 6/9) ---
VISION_LLM_API_KEY=
VISION_LLM_BASE_URL=https://api.groq.com/openai/v1
VISION_LLM_MODEL=qwen/qwen3.6-27b
VISION_LLM_MAX_FRAMES_PER_JOB=30

# --- Explanation fallback (stage 19) ---
# Free API key from openrouter.ai. Groq's free daily token quota (200K/day)
# has been hit repeatedly under real usage, silently returning an empty
# explanation — this retries once via OpenRouter's free tier instead.
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_LLM_MODEL=openai/gpt-oss-20b:free

# --- Password reset email (stage 17) ---
# Free API key from resend.com. Without a verified domain, the sandbox
# sender (onboarding@resend.dev) can only deliver to the email address that
# owns the Resend account — fine for a small/personal launch, but worth
# knowing before relying on it for other users' inboxes.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Rosetta <onboarding@resend.dev>
# Must be the real Vercel frontend URL, not localhost — this builds the
# link inside the reset email.
FRONTEND_URL=https://your-app.vercel.app
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
